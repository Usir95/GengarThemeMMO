<?xml version="1.0" encoding="UTF-8"?>
<resource name="Gengar Theme" version="1.2.11" description="Tema de interfaz inspirado en Gengar." author="Osiris">
  <themes theme_revision="11">
    <theme path="themes/gengar/" name="Gengar" is_mobile="false">
      <constants>
        <constant name="main-theme-color" public_name="Color base" type="COLOR" default_value="#735196"/>
        <constant name="main-color" public_name="Color principal" type="COLOR" default_value="#9B78C6"/>
        <constant name="sub-color" public_name="Color secundario" type="COLOR" default_value="#9B78C6"/>
      </constants>
      <constants_presets>
        <constants_preset name="Gengar">
          <constant name="main-theme-color">#735196</constant>
          <constant name="main-color">#9B78C6</constant>
          <constant name="sub-color">#9B78C6</constant>
        </constants_preset>
        <constants_preset name="Gengar Shiny">
          <constant name="main-theme-color">#8E86A8</constant>
          <constant name="main-color">#C9B8F0</constant>
          <constant name="sub-color">#B7A4E8</constant>
        </constants_preset>
        <constants_preset name="Mega Gengar">
          <constant name="main-theme-color">#6B2E5E</constant>
          <constant name="main-color">#D0479A</constant>
          <constant name="sub-color">#B83A86</constant>
        </constants_preset>
      </constants_presets>
    </theme>
