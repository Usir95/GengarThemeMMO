<?xml version="1.0" encoding="UTF-8"?>
<themes>
  <images file="res/login-bg.png" filter="linear">
    <area name="gengar-login-bg" xywh="*"/>
  </images>
  <images file="res/select-bg.png" filter="linear">
    <area name="gengar-select-bg" xywh="*"/>
  </images>
  <images file="res/gengar-login.png" filter="nearest">
    <area name="gengar-frame.background" xywh="0,0,48,48" splitx="L8,R8" splity="T31,B8"/>
    <area name="gengar-button.default" xywh="48,0,24,24" splitx="L5,R5" splity="T5,B5"/>
    <area name="gengar-button.hover" xywh="72,0,24,24" splitx="L5,R5" splity="T5,B5"/>
    <area name="gengar-button.pressed" xywh="96,0,24,24" splitx="L5,R5" splity="T5,B5"/>
    <area name="gengar-button.disabled" xywh="48,24,24,24" splitx="L5,R5" splity="T5,B5"/>
    <area name="gengar-button.focus" xywh="72,24,24,24" splitx="L5,R5" splity="T5,B5"/>
    <area name="gengar-input.default" xywh="96,24,16,16" splitx="L4,R4" splity="T4,B4"/>
    <area name="gengar-input.selected" xywh="112,24,16,16" splitx="L4,R4" splity="T4,B4"/>
    <select name="gengar-button.background">
      <alias ref="gengar-button.disabled" if="disabled"/>
      <alias ref="gengar-button.pressed" if="pressed"/>
      <alias ref="gengar-button.hover" if="hover"/>
      <alias ref="gengar-button.focus" if="keyboardFocus"/>
      <alias ref="gengar-button.default"/>
    </select>
    <alias name="gengar-button.progressbar" ref="gengar-button.hover"/>
    <select name="gengar-input.background">
      <alias ref="gengar-input.selected" if="selected | keyboardFocus"/>
      <alias ref="gengar-input.default"/>
    </select>
  </images>
  <images file="res/gengar-modern-bars.png" filter="linear">
    <area name="gengar-bars.default" xywh="0,0,48,48" splitx="L12,R12" splity="T12,B12"/>
    <area name="gengar-bars.hover" xywh="64,0,48,48" splitx="L12,R12" splity="T12,B12"/>
    <area name="gengar-bars.selected" xywh="128,0,48,48" splitx="L12,R12" splity="T12,B12"/>
    <area name="gengar-bars.disabled" xywh="192,0,48,48" splitx="L12,R12" splity="T12,B12"/>
    <area name="gengar-bars.panel" xywh="0,48,48,32" splitx="L12,R12" splity="T12,B12"/>
    <select name="gengar-bars.background">
      <alias ref="gengar-bars.disabled" if="disabled"/>
      <alias ref="gengar-bars.selected" if="selected | keyboardFocus"/>
      <alias ref="gengar-bars.hover" if="hover"/>
      <alias ref="gengar-bars.default"/>
    </select>
    <area name="gengar-bars.hp-green.background" xywh="64,54,32,2" splitx="L3,R3"/>
    <area name="gengar-bars.hp-green.progressImage" xywh="104,54,32,2" splitx="L3,R3"/>
    <area name="gengar-bars.hp-orange.background" xywh="64,54,32,2" splitx="L3,R3"/>
    <area name="gengar-bars.hp-orange.progressImage" xywh="144,54,32,2" splitx="L3,R3"/>
    <area name="gengar-bars.hp-red.background" xywh="64,54,32,2" splitx="L3,R3"/>
    <area name="gengar-bars.hp-red.progressImage" xywh="184,54,32,2" splitx="L3,R3"/>
  </images>
  <images file="res/gengar-panel-pattern.png" filter="linear">
    <area name="gengar-panel.pattern" xywh="0,0,192,192" repeatX="true" repeatY="true"/>
    <area name="gengar-panel.dex" xywh="0,0,192,192" repeatX="true" repeatY="true" inset="32,0,0,0"/>
    <area name="gengar-panel.bag" xywh="0,0,192,192" repeatX="true" repeatY="true" inset="24,0,0,0"/>
  </images>
  <images file="res/monster-info.png" filter="nearest">
    <area name="mi-label-value31" xywh="386,57,125,25"/>
    <area name="mi-label-value0" xywh="386,82,125,25"/>
  </images>
  <images file="res/breedwindow.png" filter="nearest">
    <area name="gengar-breedwindow" xywh="*" inset="-10,-25,-20,-25"/>
  </images>
  <images file="res/pcxiangzi.png" filter="nearest">
    <area name="gengar-pc" xywh="*"/>
  </images>
  <images file="res/gengar-water-levels.png" filter="linear">
    <area name="gengar-water.icon1" xywh="1,1,46,46" center="true"/>
    <area name="gengar-water.icon2" xywh="53,1,46,46" center="true"/>
    <area name="gengar-water.icon3" xywh="1,50,46,46" center="true"/>
    <area name="gengar-water.icon4" xywh="53,50,46,46" center="true"/>
    <area name="gengar-water.icon5" xywh="1,99,46,46" center="true"/>
    <area name="gengar-water.icondry" xywh="53,99,46,46" center="true"/>
    <area name="gengar-water.iconflood" xywh="1,148,46,46" center="true"/>
    <composed name="gengar-water.1">
      <alias ref="gengar-water.icon1" inset="20,-5,-80,5"/>
    </composed>
    <composed name="gengar-water.2">
      <alias ref="gengar-water.icon2" inset="20,-5,-80,5"/>
    </composed>
    <composed name="gengar-water.3">
      <alias ref="gengar-water.icon3" inset="20,-5,-80,5"/>
    </composed>
    <composed name="gengar-water.4">
      <alias ref="gengar-water.icon4" inset="20,-5,-80,5"/>
    </composed>
    <composed name="gengar-water.5">
      <alias ref="gengar-water.icon5" inset="20,-5,-80,5"/>
    </composed>
    <composed name="gengar-water.dry-a">
      <alias ref="gengar-water.icondry" inset="20,-5,-80,5"/>
    </composed>
    <animation name="gengar-water.dry" timeSource="enabled">
      <frame duration="400" ref="gengar-water.dry-a" tint="#FFFFFFFF"/>
      <frame duration="400" ref="gengar-water.dry-a" tint="#FFEC939F"/>
    </animation>
    <composed name="gengar-water.flood-a">
      <alias ref="gengar-water.iconflood" inset="20,-5,-80,5"/>
    </composed>
    <animation name="gengar-water.flood" timeSource="enabled">
      <frame duration="400" ref="gengar-water.flood-a" tint="#FFFFFFFF"/>
      <frame duration="400" ref="gengar-water.flood-a" tint="#FFA9B8FF"/>
    </animation>
  </images>
  <images file="res/battle-hud.png" filter="linear">
    <area name="gengar-move.default" xywh="640,140,209,52" splitx="L12,R80" splity="T10,B10"/>
    <area name="gengar-move.hover" xywh="640,196,209,52" splitx="L12,R80" splity="T10,B10"/>
    <area name="gengar-move.disabled" xywh="640,252,209,52" splitx="L12,R80" splity="T10,B10"/>
    <area name="gengar-list.default" xywh="0,486,200,30" splitx="L40,R8" splity="T8,B8"/>
    <area name="gengar-list.hover" xywh="205,486,200,30" splitx="L40,R8" splity="T8,B8"/>
    <area name="gengar-list.disabled" xywh="410,486,200,30" splitx="L40,R8" splity="T8,B8"/>
    <select name="gengar-list.background">
      <alias ref="gengar-list.disabled" if="disabled"/>
      <alias ref="gengar-list.hover" if="hover | keyboardFocus | selected | pressed"/>
      <alias ref="gengar-list.default"/>
    </select>
    <select name="gengar-move.background">
      <alias ref="gengar-move.disabled" if="disabled"/>
      <alias ref="gengar-move.hover" if="hover | keyboardFocus | selected | pressed"/>
      <alias ref="gengar-move.default"/>
    </select>
  </images>
</themes>
