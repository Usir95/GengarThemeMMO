<?xml version="1.0" encoding="UTF-8"?>
<themes>
  <theme name="settings-panel" merge="true">
    <theme name="dialoglayout" merge="true">
      <theme name="tabbedpane" merge="true">
        <theme name="tabbox" merge="true">
          <theme name="tabbutton" merge="true">
            <param name=""><image>gm-tab-v.*</image></param>
            <param name="minHeight"><int>28</int></param>
          </theme>
        </theme>
      </theme>
    </theme>
  </theme>
  <theme name="label-settings-title" merge="true">
    <param name="background"><image>gm-header.background</image></param>
  </theme>
  <theme name="label-settings-title-small" merge="true">
    <param name="background"><image>gm-header.background</image></param>
  </theme>
  <theme name="label-settings-header" merge="true">
    <param name="font"><font>gengar-title</font></param>
  </theme>
  <theme name="label-settings-vai" merge="true">
    <theme name="decButton" merge="true">
      <param name=""><image>gengar-button.*</image></param>
    </theme>
    <theme name="incButton" merge="true">
      <param name=""><image>gengar-button.*</image></param>
    </theme>
    <theme name="valueDisplay" merge="true">
      <param name=""><image>gengar-button.*</image></param>
    </theme>
  </theme>

  <theme name="broker-table" merge="true">
    <theme name="header-column" merge="true">
      <param name="background"><image>gm-header.background</image></param>
    </theme>
    <theme name="header-column-sort-default" merge="true">
      <param name="background"><image>gm-header.background</image></param>
    </theme>
    <theme name="header-column-sort-desc" merge="true">
      <param name="background"><image>gm-header.background</image></param>
    </theme>
    <theme name="header-column-sort-asc" merge="true">
      <param name="background"><image>gm-header.background</image></param>
    </theme>
    <theme name="box-double" merge="true">
      <param name="background"><image>gm-header.background</image></param>
    </theme>
    <theme name="box-double-warn" merge="true">
      <param name="background"><image>gm-header.background</image></param>
    </theme>
    <theme name="box-double-danger" merge="true">
      <param name="background"><image>gm-header.background</image></param>
    </theme>
    <theme name="box-double-positive" merge="true">
      <param name="background"><image>gm-header.background</image></param>
    </theme>
    <theme name="market-section-header" merge="true">
      <param name="font"><font>gengar-title</font></param>
    </theme>
    <theme name="cell" merge="true">
      <param name="background"><image>gm-cell.background</image></param>
    </theme>
    <theme name="cell-markup" merge="true">
      <param name="background"><image>gm-cell.background</image></param>
    </theme>
    <theme name="cell-warn" merge="true">
      <param name="background"><image>gm-cell.background</image></param>
    </theme>
    <theme name="cell-danger" merge="true">
      <param name="background"><image>gm-cell.background</image></param>
    </theme>
    <theme name="cell-positive" merge="true">
      <param name="background"><image>gm-cell.background</image></param>
    </theme>
    <theme name="cell-icon" merge="true">
      <param name="background"><image>gm-cell.background</image></param>
    </theme>
    <theme name="button-monster" merge="true">
      <param name="background"><image>gm-cell.background</image></param>
    </theme>
  </theme>
  <theme name="category-view" merge="true">
    <theme name="category-view-inner" merge="true">
      <theme name="dialoglayout" merge="true">
        <theme name="label-info" merge="true">
          <param name="background"><image>gm-panel.background</image></param>
        </theme>
      </theme>
    </theme>
  </theme>
  <theme name="broker-window" merge="true">
    <theme name="tabbedpane" merge="true">
      <theme name="tabbox" merge="true">
        <theme name="tabbutton" merge="true">
          <param name="background"><image>gm-header.background</image></param>
        </theme>
      </theme>
      <theme name="container" merge="true">
        <theme name="dialoglayout" merge="true">
          <theme name="label-info" merge="true">
            <param name="background"><image>gm-panel.background</image></param>
          </theme>
        </theme>
      </theme>
    </theme>
  </theme>

  <theme name="trade-frame" merge="true">
    <theme name="dialoglayout" merge="true">
      <theme name="dialoglayout" merge="true">
        <param name="background"><image>gm-panel.background</image></param>
        <theme name="pokeframe" merge="true">
          <theme name="partyslot" merge="true">
            <param name="background"><image>gengar-bars.background</image></param>
          </theme>
          <theme name="item-slot" merge="true">
            <param name="background"><image>gengar-bars.background</image></param>
          </theme>
        </theme>
        <theme name="label-horizontal-value" merge="true">
          <param name="background"><image>gm-cell.background</image></param>
        </theme>
      </theme>
    </theme>
  </theme>

  <theme name="gameshop-item" merge="true">
    <param name="background"><image>gm-card.background</image></param>
  </theme>
  <theme name="gameshop-item-addon" merge="true">
    <param name="background"><image>gm-card.background</image></param>
    <theme name="dialoglayout" merge="true">
      <theme name="spritelabel" merge="true">
        <param name="background"><image>gm-cell.background</image></param>
      </theme>
    </theme>
  </theme>
  <theme name="gameshop-item-addon-limited" merge="true">
    <param name="background"><image>gm-card.background</image></param>
  </theme>
  <theme name="gameshop-item-addon-seasonal" merge="true">
    <param name="background"><image>gm-card.background</image></param>
  </theme>
  <theme name="gameshop-item-addon-sale" merge="true">
    <param name="background"><image>gm-card.background</image></param>
  </theme>
  <theme name="gameshop-item-addon-new" merge="true">
    <param name="background"><image>gm-card.background</image></param>
  </theme>
  <theme name="gameshop" merge="true">
    <theme name="dialoglayout" merge="true">
      <theme name="tabbedpane" merge="true">
        <theme name="tabbox" merge="true">
          <theme name="tabbutton" merge="true">
            <param name="background"><image>gm-header.background</image></param>
          </theme>
        </theme>
      </theme>
    </theme>
    <theme name="points" merge="true">
      <param name="background"><image>gm-cell.background</image></param>
    </theme>
  </theme>
</themes>
